VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
# Backend API base URL — "Mark as Packed" isi par PUT karta hai.
# Local dev me backend :5000 par chalta hai, isliye default wahi rakho.
# Agar backend down/galat URL ho to frontend me "Failed to fetch" aata hai.
# Deployed backend ho to yahan uska URL dalo, jaise:
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000
